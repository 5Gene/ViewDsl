<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MaskActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="450dp">

            <!-- 底部背景原图，主要显示原始图片 -->
            <osp.sparkj.viewdsl.bitmap.ZoomImageView
                android:id="@+id/origin_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/chutian2"
                app:layout_anchor="@+id/outer"
                tools:context=".MaskActivity" />

            <!-- 中间层，把原图根据背景形状进行裁剪 -->
            <osp.sparkj.viewdsl.bitmap.MaskedFrameLayout
                android:id="@+id/bg_mask_layout"
                android:src="@drawable/bg_mask"
                android:background="#80FFFFFF"
                android:supplementalDescription="transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <osp.sparkj.viewdsl.bitmap.ZoomImageView
                    android:id="@+id/bg_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/chutian2"
                    app:layout_anchor="@+id/outer"
                    tools:context=".MaskActivity" />
            </osp.sparkj.viewdsl.bitmap.MaskedFrameLayout>

            <!-- 顶层，经 out_mask 裁切，作为 anchor 源 -->
            <osp.sparkj.viewdsl.bitmap.MaskedFrameLayout
                android:id="@+id/dof_mask_layout"
                android:src="@drawable/out_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <osp.sparkj.viewdsl.bitmap.ZoomImageView
                    android:id="@+id/outer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:tag="transform"
                    android:scaleType="centerCrop"
                    android:src="@drawable/chutian2" />
            </osp.sparkj.viewdsl.bitmap.MaskedFrameLayout>

        </FrameLayout>

        <!-- 长按 fab_share 后显示两个 MaskedFrameLayout 的截图 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_bg_capture"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="bg_mask capture" />

            <ImageView
                android:id="@+id/iv_dof_capture"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scaleType="fitCenter"
                android:contentDescription="dof_mask capture" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:transitionName="shared_element_container"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
